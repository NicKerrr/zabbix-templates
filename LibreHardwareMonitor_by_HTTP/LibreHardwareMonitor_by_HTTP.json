        "templates": [
            {
                "uuid": "6b9b98201c974898a440b78d210184c4",
                "template": "LibreHardwareMonitor by HTTP",
                "name": "LibreHardwareMonitor by HTTP",
                "description": "LibreHardwareMonitor monitoring via HTTP API. Discovers CPU, GPU, NVMe, HDD/SSD temperature sensors and fan speed sensors, collects hardware metrics from data.json and creates temperature threshold triggers.\n\n\nAuthor: Yaroslav Sharaev https://github.com/NicKerrr/zabbix-templates",
                "vendor": {
                    "name": "Yaroslav Sharaev",
                    "version": "0.8.2"
                },
                "groups": [
                    {
                        "name": "Templates"
                    }
                ],
                "items": [
                    {
                        "uuid": "25c7e287a9b6411c9a77be3ac69045eb",
                        "name": "LHM Raw Data",
                        "type": "HTTP_AGENT",
                        "key": "lhm.raw.data",
                        "delay": "5s",
                        "history": "0",
                        "value_type": "TEXT",
                        "authtype": "BASIC",
                        "username": "{$LHM.USER}",
                        "password": "{$LHM.PASSWORD}",
                        "url": "{$LHM.URL}/data.json",
                        "headers": [
                            {
                                "name": "content-type",
                                "value": "application/json"
                            }
                        ],
                        "tags": [
                            {
                                "tag": "Application",
                                "value": "LHM"
                            },
                            {
                                "tag": "component",
                                "value": "raw"
                            }
                        ]
                    }
                ],
                "discovery_rules": [
                    {
                        "uuid": "45e20291fa8c4c7c873fb29a082ca11a",
                        "name": "Get CPU",
                        "type": "DEPENDENT",
                        "key": "lhm.get.cpu",
                        "item_prototypes": [
                            {
                                "uuid": "79a8341a738d48289204cdc029a3a03b",
                                "name": "Hardware: CPU Temperature [{#CPU.TEMP.NAME}] in \u00b0C",
                                "type": "DEPENDENT",
                                "key": "lhm.cpu.temp[\"{#CPU.TEMP.ID}\"]",
                                "trends": "0",
                                "units": "\u00b0C",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.Children[0].Children[?(@.HardwareId =~ \"^/(intelcpu|amdcpu)/[0-9]+$\")].Children.[?(@.Text == \"Temperatures\")].Children.[?(@.SensorId == \"{#CPU.TEMP.ID}\")].Value.first()"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            ",",
                                            "."
                                        ]
                                    },
                                    {
                                        "type": "RTRIM",
                                        "parameters": [
                                            " \u00b0C"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "lhm.raw.data"
                                },
                                "tags": [
                                    {
                                        "tag": "Application",
                                        "value": "LHM"
                                    },
                                    {
                                        "tag": "CPU",
                                        "value": "{#CPU.TEMP.NAME}"
                                    },
                                    {
                                        "tag": "Hardware",
                                        "value": "CPU"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "c06c0d029fbc4dbeaa8b15674716548d",
                                        "expression": "avg(/LibreHardwareMonitor by HTTP/lhm.cpu.temp[\"{#CPU.TEMP.ID}\"],5m)>{$CPU.TEMP.AVERAGE}",
                                        "name": "Hardware: CPU [{#CPU.TEMP.NAME}] temperature is average",
                                        "discover": "NO_DISCOVER",
                                        "priority": "AVERAGE",
                                        "dependencies": [
                                            {
                                                "name": "Hardware: CPU [{#CPU.TEMP.NAME}] temperature is high",
                                                "expression": "avg(/LibreHardwareMonitor by HTTP/lhm.cpu.temp[\"{#CPU.TEMP.ID}\"],5m)>{$CPU.TEMP.HIGH}"
                                            }
                                        ],
                                        "tags": [
                                            {
                                                "tag": "Application",
                                                "value": "LHM"
                                            },
                                            {
                                                "tag": "Hardware",
                                                "value": "CPU"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "586218d7d03f4a75a425c9b2eca4c34b",
                                        "expression": "avg(/LibreHardwareMonitor by HTTP/lhm.cpu.temp[\"{#CPU.TEMP.ID}\"],5m)>{$CPU.TEMP.HIGH}",
                                        "name": "Hardware: CPU [{#CPU.TEMP.NAME}] temperature is high",
                                        "discover": "NO_DISCOVER",
                                        "priority": "HIGH",
                                        "tags": [
                                            {
                                                "tag": "Application",
                                                "value": "LHM"
                                            },
                                            {
                                                "tag": "Hardware",
                                                "value": "CPU"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "c0c7ed695bfb4427b32753ec8e4e3ac4",
                                        "expression": "avg(/LibreHardwareMonitor by HTTP/lhm.cpu.temp[\"{#CPU.TEMP.ID}\"],5m)>{$CPU.TEMP.WARNING}",
                                        "name": "Hardware: CPU [{#CPU.TEMP.NAME}] temperature is warning",
                                        "discover": "NO_DISCOVER",
                                        "priority": "WARNING",
                                        "dependencies": [
                                            {
                                                "name": "Hardware: CPU [{#CPU.TEMP.NAME}] temperature is average",
                                                "expression": "avg(/LibreHardwareMonitor by HTTP/lhm.cpu.temp[\"{#CPU.TEMP.ID}\"],5m)>{$CPU.TEMP.AVERAGE}"
                                            }
                                        ],
                                        "tags": [
                                            {
                                                "tag": "Application",
                                                "value": "LHM"
                                            },
                                            {
                                                "tag": "Hardware",
                                                "value": "CPU"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ],
                        "master_item": {
                            "key": "lhm.raw.data"
                        },
                        "lld_macro_paths": [
                            {
                                "lld_macro": "{#CPU.TEMP.ID}",
                                "path": "$.SensorId"
                            },
                            {
                                "lld_macro": "{#CPU.TEMP.NAME}",
                                "path": "$.Text"
                            }
                        ],
                        "preprocessing": [
                            {
                                "type": "JSONPATH",
                                "parameters": [
                                    "$.Children[0].Children[?(@.HardwareId =~ \"^/(intelcpu|amdcpu)/[0-9]+$\")].Children[?(@.Text == \"Temperatures\")].Children[*]"
                                ]
                            }
                        ],
                        "overrides": [
                            {
                                "name": "Create CPU main temperature trigger",
                                "step": "1",
                                "filter": {
                                    "conditions": [
                                        {
                                            "macro": "{#CPU.TEMP.NAME}",
                                            "value": "^\\s*(CPU Package|Core \\(Tctl/Tdie\\))\\s*$"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "temperature is",
                                        "discover": "DISCOVER"
                                    }
                                ]
                            }
                        ]
                    },
