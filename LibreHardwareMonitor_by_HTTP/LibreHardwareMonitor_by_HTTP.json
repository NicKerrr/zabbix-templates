                                    "var root = JSON.parse(value);\nvar result = [];\n\nfunction walk(node) {\n    if (!node || typeof node !== \"object\") {\n        return;\n    }\n\n    if (node.HardwareId && /^\\/nvme\\/[0-9]+$/.test(node.HardwareId)) {\n        var nvmeId = node.HardwareId;\n        var nvmeName = node.Text || nvmeId;\n\n        var groups = node.Children || [];\n\n        for (var i = 0; i < groups.length; i++) {\n            var group = groups[i];\n\n            if (group.Text !== \"Temperatures\") {\n                continue;\n            }\n\n            var sensors = group.Children || [];\n\n            for (var j = 0; j < sensors.length; j++) {\n                var sensor = sensors[j];\n\n                if (sensor.Type !== \"Temperature\") {\n                    continue;\n                }\n\n                result.push({\n                    \"{#LHM.NVME.ID}\": nvmeId,\n                    \"{#LHM.NVME.NAME}\": nvmeName,\n                    \"{#LHM.NVME.TEMP.ID}\": sensor.SensorId,\n                    \"{#LHM.NVME.TEMP.NAME}\": sensor.Text\n                });\n            }\n        }\n    }\n\n    var children = node.Children || [];\n    for (var k = 0; k < children.length; k++) {\n        walk(children[k]);\n    }\n}\n\nwalk(root);\n\nreturn JSON.stringify(result);"
                                ]
                            }
