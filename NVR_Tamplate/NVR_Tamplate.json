                                        "tag": "drive",
                                        "value": "{#NVR.DRIVES.NO}"
                                    }
                                ]
                            },
                            {
                                "uuid": "7d469f88080f4f32b74db641048d7c75",
                                "name": "NVR: Drive [{#NVR.DRIVES.NO}] Record Start Time",
                                "type": "DEPENDENT",
                                "key": "nvr.drives.startrectime.[{#NVR.DRIVES.NO}]",
                                "value_type": "TEXT",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.disks.[?(@.PlysicalNo == \"{#NVR.DRIVES.NO}\" )].Partition.[?(@.IsCurrent == \"true\" )].NewStartTime.first()"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
