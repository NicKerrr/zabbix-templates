                "macros": [
                    {
                        "macro": "{$NVR.USER}"
                    },
                    {
                        "macro": "{$NVR.PASSWORD}"
                    },
                    {
                        "macro": "{$NVR.PORT}"
                    }
                ],
                "valuemaps": [
                    {
                        "uuid": "77f2e9fd6f1841c886c962c9f2705af2",
                        "name": "Channel Status",
                        "mappings": [
                            {
                                "value": "0",
                                "newvalue": "Offline"
                            },
                            {
                                "value": "1",
                                "newvalue": "Unknown"
                            },
                            {
                                "value": "2",
                                "newvalue": "None"
                            },
                            {
                                "value": "3",
                                "newvalue": "Login Failed"
                            },
                            {
                                "value": "4",
                                "newvalue": "No Login"
                            },
                            {
                                "value": "5",
                                "newvalue": "No Connect"
                            },
                            {
                                "value": "6",
                                "newvalue": "No Config"
                            },
                            {
                                "value": "10",
                                "newvalue": "Connected"
                            }
                        ]
                    },
                    {
                        "uuid": "74bc2a79fc3a4d5da16fe44a8ca0097e",
                        "name": "Dirver Type",
