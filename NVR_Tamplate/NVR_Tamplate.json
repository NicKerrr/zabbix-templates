                                        "tag": "application",
                                        "value": "NVR"
                                    },
                                    {
                                        "tag": "drive",
                                        "value": "{#NVR.DRIVES.NO}"
                                    }
                                ]
                            },
                            {
                                "uuid": "ab828cebcac048d48357ca4fd5a9d47a",
                                "name": "NVR: Drive [{#NVR.DRIVES.NO}] Record End Time",
                                "type": "DEPENDENT",
                                "key": "nvr.drives.endrectime.[{#NVR.DRIVES.NO}]",
                                "value_type": "TEXT",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.disks.[?(@.PlysicalNo == \"{#NVR.DRIVES.NO}\" )].Partition.[?(@.IsCurrent == \"true\" )].NewEndTime.first()"
