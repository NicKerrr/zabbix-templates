                                            "1d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                                },
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "NVR"
                                    },
                                    {
                                        "tag": "drive",
                                        "value": "{#NVR.DRIVES.NO}"
                                    }
                                ]
                            },
                            {
                                "uuid": "f72b7d3414aa45fd95a82b573d968835",
                                "name": "NVR: Drive [{#NVR.DRIVES.NO}] Status",
                                "type": "DEPENDENT",
                                "key": "nvr.drives.status.[{#NVR.DRIVES.NO}]",
                                "valuemap": {
                                    "name": "Drive Status"
                                },
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.disks.[?(@.PlysicalNo == \"{#NVR.DRIVES.NO}\" )].Partition.[?(@.IsCurrent == \"true\" )].Status.first()"
                                        ]
                                    },
                                    {
                                        "type": "JAVASCRIPT",
                                        "parameters": [
                                            "var v = parseInt(value, 10);\n\nif (v === 0) {\n    return 0;\n}\n\nreturn 1;"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                        "parameters": [
                                            "1d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                                },
                                "tags": [
