                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "69b37857e13745f5a9d1645bb2cf3e20",
                                        "expression": "last(/NVR Template/nvr.drives.status.[{#NVR.DRIVES.NO}])=1",
                                        "name": "NVR: Drive [{#NVR.DRIVES.NO}] Status is Error",
                                        "priority": "HIGH"
                                    }
                                ]
                            },
                            {
                                "uuid": "9d78bc68b9274478837399e66093095b",
                                "name": "NVR: Drive [{#NVR.DRIVES.NO}] Total Space",
                                "type": "DEPENDENT",
                                "key": "nvr.drives.totalspace.[{#NVR.DRIVES.NO}]",
                                "units": "B",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.disks.[?(@.PlysicalNo == \"{#NVR.DRIVES.NO}\" )].Partition.[?(@.IsCurrent == \"true\" )].TotalSpace.first()"
                                        ]
                                    },
                                    {
                                        "type": "JAVASCRIPT",
                                        "parameters": [
                                            "return parseInt(value, 16) * 1024 * 1024;"
                                        ]
