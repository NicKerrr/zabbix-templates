                                "master_item": {
                                    "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                                },
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "NVR"
                                    },
