                "discovery_rules": [
                    {
                        "uuid": "ef71caf4c180438b84d4dfd7684446f2",
                        "name": "Get Channels",
                        "type": "DEPENDENT",
                        "key": "nvr.get.channels",
                        "item_prototypes": [
                            {
                                "uuid": "18be204e4d3c47b4b92edc96605f95df",
                                "name": "Active Channel [{#NVR.CH.NAME}] Current Resolution",
                                "type": "DEPENDENT",
                                "key": "nvr.ch.curres.[{#NVR.CH.INDEX}]",
                                "value_type": "TEXT",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.channels.[?(@.name == \"{#NVR.CH.NAME}\" )].curres.first()"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                        "parameters": [
                                            "10d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                                },
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "NVR"
                                    },
                                    {
                                        "tag": "channel",
                                        "value": "{#NVR.CH.NAME}"
                                    }
                                ]
                            },
                            {
                                "uuid": "a90f9ce6138142a287db4e7971e8733e",
                                "name": "Active Channel [{#NVR.CH.NAME}] Status",
                                "type": "DEPENDENT",
                                "key": "nvr.ch.status.[{#NVR.CH.INDEX}]",
                                "trends": "0",
                                "valuemap": {
                                    "name": "Channel Status"
                                },
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.channels.[?(@.name == \"{#NVR.CH.NAME}\" )].status.first()"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "Connected",
                                            "10"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "NoConfig",
                                            "6"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "NoConnect",
                                            "5"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "NoLogin",
                                            "4"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "LoginFailed",
                                            "3"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "Offline",
                                            "0"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "Unknown",
                                            "1"
                                        ]
                                    },
                                    {
                                        "type": "STR_REPLACE",
                                        "parameters": [
                                            "None",
                                            "2"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                                },
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "NVR"
                                    },
                                    {
                                        "tag": "channel",
                                        "value": "{#NVR.CH.NAME}"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "f016059ec6d442d99a8a999e57e1dacf",
                                        "expression": "last(/NVR Template/nvr.ch.status.[{#NVR.CH.INDEX}])=3",
                                        "name": "NVR: Channel [{#NVR.CH.NAME}] Status is Login Failed",
                                        "priority": "WARNING",
                                        "tags": [
                                            {
                                                "tag": "application",
                                                "value": "NVR"
                                            },
                                            {
                                                "tag": "channel",
                                                "value": "{#NVR.CH.NAME}"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "d54382935659497799d7ccbe7cf398db",
                                        "expression": "last(/NVR Template/nvr.ch.status.[{#NVR.CH.INDEX}])<> 10 and last(/NVR Template/nvr.ch.status.[{#NVR.CH.INDEX}])<> 0",
                                        "name": "NVR: Channel [{#NVR.CH.NAME}] Status is not Connected",
                                        "priority": "WARNING",
                                        "tags": [
                                            {
                                                "tag": "application",
                                                "value": "NVR"
                                            },
                                            {
                                                "tag": "channel",
                                                "value": "{#NVR.CH.NAME}"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "fd1ba9bdf4cf4e80b0fa522b108ac9c9",
                                        "expression": "last(/NVR Template/nvr.ch.status.[{#NVR.CH.INDEX}])=0",
                                        "name": "NVR: Channel [{#NVR.CH.NAME}] Status is Offline",
                                        "priority": "HIGH",
                                        "tags": [
                                            {
                                                "tag": "application",
                                                "value": "NVR"
                                            },
                                            {
                                                "tag": "channel",
                                                "value": "{#NVR.CH.NAME}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ],
                        "master_item": {
                            "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                        },
                        "lld_macro_paths": [
                            {
                                "lld_macro": "{#NVR.CH.INDEX}",
                                "path": "$.index"
                            },
                            {
                                "lld_macro": "{#NVR.CH.NAME}",
                                "path": "$.name"
                            }
                        ],
                        "preprocessing": [
                            {
                                "type": "JSONPATH",
                                "parameters": [
                                    "$.channels[?(@.active == \"true\")]"
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "e30e55e6a0b042bba830198a86ebd0f1",
                        "name": "Get Drives",
                        "type": "DEPENDENT",
                        "key": "nvr.get.drives",
                        "item_prototypes": [
                            {
                                "uuid": "1eab1c1b41064068b6486e8cced31bf7",
                                "name": "NVR: Drive [{#NVR.DRIVES.NO}] Type",
                                "type": "DEPENDENT",
                                "key": "nvr.drives.dirvertype.[{#NVR.DRIVES.NO}]",
                                "valuemap": {
                                    "name": "Dirver Type"
                                },
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.disks.[?(@.PlysicalNo == \"{#NVR.DRIVES.NO}\" )].Partition.[?(@.IsCurrent == \"true\" )].DirverType.first()"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                        "parameters": [
                                            "1d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "nvr.raw.data.py[\"--host\",\"{HOST.CONN}\",\"--user\",\"{$NVR.USER}\",\"--password\",\"{$NVR.PASSWORD}\",\"--port\",\"{$NVR.PORT}\"]"
                                },
