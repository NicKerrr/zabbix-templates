{
    "zabbix_export": {
        "version": "7.0",
        "template_groups": [
            {
                "uuid": "c2c162144c2d4c5491c8801193af4945",
                "name": "Templates/Cloud"
            }
        ],
        "templates": [
            {
                "uuid": "cd4f837c4d6f49cd870c6caa934b9805",
                "template": "Reg.ru by HTTP",
                "name": "Reg.ru by HTTP",
                "description": "Reg.ru services monitoring via HTTP API. Discovers domains and hosting services, collects creation date, expiration date and service state, and creates alerts for expiration in 60, 30 and 7 days.\n\n\nAuthor: Yaroslav Sharaev https://github.com/NicKerrr/zabbix-templates",
                "vendor": {
                    "name": "Yaroslav Sharaev",
                    "version": "0.9"
                },
                "groups": [
                    {
                        "name": "Templates/Cloud"
                    }
                ],
                "items": [
                    {
                        "uuid": "485141a0eddb4cc6bcf174961a3b0414",
                        "name": "Get Raw Domain Data",
                        "type": "HTTP_AGENT",
                        "key": "reg.raw.domain.data",
                        "delay": "10m",
                        "history": "0",
                        "value_type": "TEXT",
                        "url": "https://api.reg.ru/api/regru2/service/get_list",
                        "posts": "username={$USERNAME}&password={$API.PASSWORD}&servtype=domain",
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "request_method": "POST"
                    },
                    {
                        "uuid": "512d6b8c8e88437fa01b7b049e0a092e",
                        "name": "Get Raw Hosting Data",
                        "type": "HTTP_AGENT",
                        "key": "reg.raw.hosting.data",
                        "delay": "10m",
                        "history": "0",
                        "value_type": "TEXT",
                        "url": "https://api.reg.ru/api/regru2/service/get_list",
                        "posts": "username={$USERNAME}&password={$API.PASSWORD}&servtype=srv_hosting_ispmgr",
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "request_method": "POST"
                    }
                ],
                "discovery_rules": [
                    {
                        "uuid": "a73cf47397034f6e9dc59241a3eff402",
                        "name": "Get domain list",
                        "type": "DEPENDENT",
                        "key": "reg.domain.list",
                        "item_prototypes": [
                            {
                                "uuid": "7daf76e907774f18ae0ab7866a638aa8",
                                "name": "Domain [{#DOMAIN}]: Creation Date",
                                "type": "DEPENDENT",
                                "key": "reg.domain.creation.date.[{#DOMAIN}]",
                                "value_type": "TEXT",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.answer.services"
                                        ]
                                    },
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.[?(@.dname == '{#DOMAIN}')].creation_date.first()"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                        "parameters": [
                                            "10d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "reg.raw.domain.data"
                                },
                                "tags": [
                                    {
                                        "tag": "Domain",
                                        "value": "{#DOMAIN}"
                                    }
                                ]
                            },
                            {
                                "uuid": "a40faad6b4e34309bcc38d7052785c1d",
                                "name": "Domain [{#DOMAIN}]: Expiration Date",
                                "type": "DEPENDENT",
                                "key": "reg.domain.expiration.date.[{#DOMAIN}]",
                                "trends": "0",
                                "units": "unixtime",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.answer.services"
                                        ]
                                    },
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.[?(@.dname == '{#DOMAIN}')].expiration_date.first()"
                                        ]
                                    },
                                    {
                                        "type": "JAVASCRIPT",
                                        "parameters": [
                                            "var p = value.trim().split('-');\n\nif (p.length !== 3) {\n    throw 'Invalid date format: ' + value;\n}\n\nvar year = parseInt(p[0], 10);\nvar month = parseInt(p[1], 10) - 1; \nvar day = parseInt(p[2], 10);\n\nreturn Math.floor(Date.UTC(year, month, day) / 1000);"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                        "parameters": [
                                            "1d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "reg.raw.domain.data"
                                },
                                "tags": [
                                    {
                                        "tag": "Domain",
                                        "value": "{#DOMAIN}"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "eb650a9681b9493bac34eee9a4974821",
                                        "expression": "last(/Reg.ru by HTTP/reg.domain.expiration.date.[{#DOMAIN}])  - now() <= 7d",
                                        "name": "Domain [{#DOMAIN}]: expires in 7 days",
                                        "priority": "AVERAGE"
                                    },
                                    {
                                        "uuid": "af1c02e3916e49d3992abfc7eed922dc",
                                        "expression": "last(/Reg.ru by HTTP/reg.domain.expiration.date.[{#DOMAIN}])  - now() <= 30d",
                                        "name": "Domain [{#DOMAIN}]: expires in 30 days",
                                        "priority": "WARNING",
                                        "dependencies": [
                                            {
                                                "name": "Domain [{#DOMAIN}]: expires in 7 days",
                                                "expression": "last(/Reg.ru by HTTP/reg.domain.expiration.date.[{#DOMAIN}])  - now() <= 7d"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "05c1db7d70834171886d3d2236fbeffa",
                                        "expression": "last(/Reg.ru by HTTP/reg.domain.expiration.date.[{#DOMAIN}])  - now() <= 60d",
                                        "name": "Domain [{#DOMAIN}]: expires in 60 days",
                                        "priority": "INFO",
                                        "dependencies": [
                                            {
                                                "name": "Domain [{#DOMAIN}]: expires in 30 days",
                                                "expression": "last(/Reg.ru by HTTP/reg.domain.expiration.date.[{#DOMAIN}])  - now() <= 30d"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "uuid": "7f7a2f37796943d1962469bd46795084",
                                "name": "Domain [{#DOMAIN}]: State",
                                "type": "DEPENDENT",
                                "key": "reg.domain.state.[{#DOMAIN}]",
                                "value_type": "TEXT",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.answer.services"
                                        ]
                                    },
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$.[?(@.dname == '{#DOMAIN}')].state.first()"
                                        ]
                                    },
                                    {
                                        "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                        "parameters": [
                                            "1d"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "reg.raw.domain.data"
                                },
                                "tags": [
                                    {
                                        "tag": "Domain",
                                        "value": "{#DOMAIN}"
                                    }
                                ]
                            }
                        ],
                        "master_item": {
                            "key": "reg.raw.domain.data"
                        },
                        "lld_macro_paths": [
                            {
                                "lld_macro": "{#DOMAIN}",
                                "path": "$..dname.first()"
                            }
                        ],
                        "preprocessing": [
                            {
                                "type": "JSONPATH",
                                "parameters": [
                                    "$.answer.services"
                                ]
                            }
                        ]
                    },
                    {
